#parse("fragments/icon-mappings")
#parse("fragments/authenticator-button")

#define($_loginChooser)

    #if(!$_loginChooser_hide_selector_title)
    <h1 class="mt0 center">#message("views.select-authenticator.page.selector.title")</h1>
    #end

    #foreach($_authenticatorMapItem in $_allowedAuthenticators.values())

        <div class="form-field #if($icons_only_authenticator_chooser)form-field-social-icon#end mb1">
            #set($_authenticatorButtonClasses = "button-social-single-color")
            #if($icons_only_authenticator_chooser)
                #set($_authenticatorButtonClasses = "button-social-icon button-social-single-color")
            #end
            #set($_showAuthenticatorDescription = !$icons_only_authenticator_chooser)
            #authenticatorButton($_authenticatorMapItem $_authenticatorMapItem.authenticatorId $_authenticatorButtonClasses $_showAuthenticatorDescription false)
        </div>

    #end

#end
